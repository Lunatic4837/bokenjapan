<!DOCTYPE html>
<html lang="ja">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
  <!-- [Phase1] SEO-08: タイトルに地域名追加 -->
  <title>沖縄そば 悠愉樹庵（ゆうゆじゅあん）｜中城村の古民家沖縄そば専門店</title>

  <!-- SEO・OGP -->
  <meta name="description" content="中城城跡から車5分。沖縄古民家で味わう自家製沖縄そば専門店『悠愉樹庵』。化学調味料不使用の出汁と県産豚肉のソーキ・テビチが自慢。駐車場15台・全69席。テレビ朝日『人生の楽園』紹介店。">
  <!-- [Phase1] SEO-02: og:type 追加 -->
  <meta property="og:type" content="website" />
  <meta property="og:title" content="沖縄そば 悠愉樹庵" />
  <meta property="og:description" content="中城城跡から車5分。沖縄古民家で味わう化学調味料不使用の沖縄そば。駐車場15台・全69席。" />
  <meta property="og:image" content="https://jyuan.jp/ogp.jpg" />
  <meta property="og:url" content="https://jyuan.jp/" />
  <!-- Favicon -->
  <link rel="icon" type="image/x-icon" href="/favicon.ico">
  <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png">
  <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png">
  <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png">

  <link rel="canonical" href="https://jyuan.jp/">
  <link rel="alternate" hreflang="ja" href="https://jyuan.jp/">
  <link rel="alternate" hreflang="en" href="https://jyuan.jp/en/">

  <!-- [Phase1] PERF-01: LCP画像プリロード -->
  <link rel="preload" as="image" href="images/exterior1.jpg" fetchpriority="high">

  <!-- TailwindCSS (ビルド版) -->
  <link rel="stylesheet" href="/css/style.css">

  <!-- Google Fonts -->
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Sawarabi+Mincho&display=swap" rel="stylesheet">

  <!-- [Phase2] SEO-03 + [Phase4] SEO-07: JSON-LD 拡充（全カテゴリ網羅） -->
  <script type="application/ld+json">
{
  "@context": "https://schema.org",
  "@type": "Restaurant",
