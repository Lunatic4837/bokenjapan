  "servesCuisine": ["沖縄そば", "沖縄料理", "郷土料理", "Okinawa Soba"],
  "priceRange": "¥900〜¥1,600",
  "acceptsReservations": "False",
  "hasMenu": {
    "@type": "Menu",
    "url": "https://jyuan.jp/#menu",
    "hasMenuSection": [
      {
        "@type": "MenuSection",
        "name": "沖縄そば",
        "hasMenuItem": [
          { "@type": "MenuItem", "name": "悠愉（ゆうゆ）そば", "description": "軟骨ソーキ・三枚肉・かまぼこを贅沢にのせた当店イチオシの沖縄そば", "offers": { "@type": "Offer", "price": "1200", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "軟骨ソーキそば", "description": "とろけるような柔らかさに煮込んだ特大ボリュームの軟骨ソーキそば", "offers": { "@type": "Offer", "price": "1250", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "テビチそば", "description": "ぷるぷるのテビチを贅沢に使った一杯", "offers": { "@type": "Offer", "price": "1200", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "三枚肉そば", "description": "三枚肉とかまぼこをのせた王道の沖縄そば", "offers": { "@type": "Offer", "price": "900", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "お子様そば", "description": "ミニ三枚肉そばとじゅーしーのセット", "offers": { "@type": "Offer", "price": "550", "priceCurrency": "JPY" } }
        ]
      },
      {
        "@type": "MenuSection",
        "name": "定食",
        "hasMenuItem": [
          { "@type": "MenuItem", "name": "テビチ定食", "description": "トロトロのテビチに大根・昆布・豆腐を加えたボリューム満点の定食", "offers": { "@type": "Offer", "price": "1600", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "軟骨ソーキ定食", "description": "特大ボリュームの軟骨ソーキ定食", "offers": { "@type": "Offer", "price": "1600", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "イナムドゥチ定食", "description": "沖縄のお祝い料理イナムドゥチの定食", "offers": { "@type": "Offer", "price": "1600", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "ゆし豆腐定食", "description": "ニラと自家製味噌のゆし豆腐定食", "offers": { "@type": "Offer", "price": "1000", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "へちま定食", "description": "へちまを自家製味噌で煮込んだ定食", "offers": { "@type": "Offer", "price": "1200", "priceCurrency": "JPY" } }
        ]
      },
      {
        "@type": "MenuSection",
        "name": "チャンプルー",
        "hasMenuItem": [
          { "@type": "MenuItem", "name": "豆腐チャンプルー", "description": "島豆腐と県産彩り野菜のチャンプルー", "offers": { "@type": "Offer", "price": "1000", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "ゴーヤーチャンプルー", "description": "ゴーヤーと島豆腐のチャンプルー", "offers": { "@type": "Offer", "price": "1000", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "フーチャンプルー", "description": "車麩と県産野菜のチャンプルー", "offers": { "@type": "Offer", "price": "1000", "priceCurrency": "JPY" } }
        ]
      },
      {
        "@type": "MenuSection",
        "name": "単品",
        "hasMenuItem": [
          { "@type": "MenuItem", "name": "ジーマミ豆腐", "description": "自家製のもちもちピーナッツ豆腐", "offers": { "@type": "Offer", "price": "300", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "もずく天ぷら", "description": "沖縄産もずくの天ぷら", "offers": { "@type": "Offer", "price": "60", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "イリチャー", "description": "切り干し大根と昆布の炒め煮", "offers": { "@type": "Offer", "price": "400", "priceCurrency": "JPY" } }
        ]
      },
      {
        "@type": "MenuSection",
        "name": "デザート",
        "hasMenuItem": [
          { "@type": "MenuItem", "name": "自家製チーズケーキ", "description": "紅芋または里芋を使った季節の自家製チーズケーキ", "offers": { "@type": "Offer", "price": "400", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "ケーキセット", "description": "自家製チーズケーキとコーヒーまたは紅茶のセット", "offers": { "@type": "Offer", "price": "700", "priceCurrency": "JPY" } },
          { "@type": "MenuItem", "name": "黒糖ぜんざい", "description": "沖縄産黒糖のかき氷ぜんざい", "offers": { "@type": "Offer", "price": "500", "priceCurrency": "JPY" } }
        ]
      }
    ]
  },
  "openingHoursSpecification": [
    {
      "@type": "OpeningHoursSpecification",
      "dayOfWeek": ["Monday","Tuesday","Wednesday","Thursday","Friday","Saturday"],
      "opens": "11:00",
      "closes": "15:00"
    }
  ],
  "sameAs": [
    "https://maps.app.goo.gl/viwUGsYm7mVw3dFz6",
    "https://www.instagram.com/yuyu_jyuan/",
    "https://tabelog.com/okinawa/A4704/A470405/47005254/"
  ]
}
</script>

  <!-- [Phase1] BUG-01: gtag 統合（1回のみ読み込み） -->
  <script async src="https://www.googletagmanager.com/gtag/js?id=G-B07XFP4Y65"></script>
