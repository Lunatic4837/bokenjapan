</head>

<body class="bg-gray-100 text-gray-800 min-h-screen" style="background-image: url('images/bingata-strong.png'); background-repeat: repeat; background-position: center; background-size: 100% auto;">

<!-- Header -->
<header class="bg-white bg-opacity-90 shadow fixed w-full z-50">
  <div class="max-w-6xl mx-auto px-4 py-3 flex justify-between items-center">
    <h1 class="text-2xl font-bold text-red-700">悠愉樹庵（ゆうゆじゅあん）</h1>
    <button id="menuToggle"
        class="md:hidden text-2xl"
        onclick="toggleMenu()"
        aria-controls="navMobile"
        aria-expanded="false">
        &#9776;
    </button>
    <nav id="main-nav" class="hidden md:flex space-x-4 text-sm items-center">
      <a href="#menu" class="hover:text-red-600">お品書き</a>
      <a href="#concept" class="hover:text-red-600">こだわり</a>
      <a href="#info" class="hover:text-red-600">店舗案内</a>
      <a href="#access" class="hover:text-red-600">アクセス</a>
      <a href="#interior" class="hover:text-red-600">店舗内観（客席）</a>
      <a href="#exterior" class="hover:text-red-600">店舗外観</a>
      <a href="#publicity" class="hover:text-red-600">お知らせ</a>
      <a href="#store-origin" class="hover:text-red-600">店名の由来</a>
      <a href="/en/" class="text-white px-3 py-1 rounded hover:opacity-90" style="background-color: #2f3591;">English</a>
    </nav>
  </div>
  <div id="navMobile" class="sm:hidden hidden px-4 pb-4">
    <a href="#menu" class="block py-2 border-b" onclick="closeMobileMenu()">お品書き</a>
    <a href="#concept" class="block py-2 border-b" onclick="closeMobileMenu()">こだわり</a>
    <a href="#info" class="block py-2 border-b" onclick="closeMobileMenu()">店舗案内</a>
    <a href="#access" class="block py-2 border-b" onclick="closeMobileMenu()">アクセス</a>
    <a href="#publicity" class="block py-2 border-b" onclick="closeMobileMenu()">お知らせ</a>
    <a href="#interior" class="block py-2 border-b" onclick="closeMobileMenu()">店舗内観（客席）</a>
    <a href="#exterior" class="block py-2 border-b" onclick="closeMobileMenu()">店舗外観</a>
    <a href="#store-origin" class="block py-2 border-b" onclick="closeMobileMenu()">店名の由来</a>
    <a href="/en/" class="block py-2 font-bold" style="color: #2f3591;" onclick="closeMobileMenu()">English Menu</a>
  </div>
</header>

<!-- Hero -->
<section id="hp-top" class="h-screen flex items-center justify-center relative text-white text-center pt-20 overflow-hidden">
  <!-- [Phase2] SEO-04: 全画像に具体的な alt テキスト設定 -->
  <!-- [Phase3] PERF-02: 2枚目以降に loading="lazy" 追加 -->
  <div id="heroSlider" class="absolute inset-0 w-full h-full z-0">
    <img src="images/exterior1.jpg" alt="悠愉樹庵の外観 - 緑に囲まれた沖縄の古民家" width="1920" height="1200"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-100 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/exterior2.jpg" alt="悠愉樹庵の入口 - 木々に囲まれた石畳のアプローチ" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/yuyu-soba.jpg" alt="悠愉（ゆうゆ）そば - 軟骨ソーキ・三枚肉・かまぼこを贅沢にのせた当店イチオシの沖縄そば" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/exterior3.JPG" alt="悠愉樹庵の庭 - 自然豊かな中城村の風景" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/nankotsu-soba.jpg" alt="軟骨ソーキそば - とろけるような柔らかさの特大軟骨ソーキ" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/exterior4.JPG" alt="悠愉樹庵の外観 - 赤瓦屋根の伝統的な沖縄古民家" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/exterior5.JPG" alt="悠愉樹庵の看板と外観 - 沖縄そば専門店" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/exterior6.JPG" alt="悠愉樹庵の駐車場周辺 - 緑豊かな敷地" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
    <img src="images/exterior7.JPG" alt="悠愉樹庵の全景 - 中城村屋宜の古民家レストラン" width="1920" height="1200" loading="lazy"
      class="w-full h-full object-cover scale-100 absolute transition-opacity duration-1000 opacity-0 transition-transform ease-in-out duration-[5000ms]" style="z-index:-1;" />
  </div>
  <div class="bg-black bg-opacity-40 absolute inset-0"></div>
  <div class="z-10 px-4">
    <h2 class="text-[1.6875rem] md:text-[3.375rem] font-semibold mb-6">悠愉樹庵（ゆうゆじゅあん）</h2>
    <p class="text-[1.125rem] md:text-[1.6875rem] leading-relaxed">
      木々に囲まれたどこか懐かしい古民家で、<br>県産食材で織りなす心あたたまる沖縄そばを。
    </p>
  </div>
</section>

<!-- [Phase3] CODE-01: キャラクターロゴ位置修正（left-[-55px]→left-4） yuyu-updated.html から採用 -->
<a href="#hp-top" class="fixed bottom-[70px] left-2 w-[100px] md:bottom-4 md:left-4 md:w-[300px] z-[9999] cursor-pointer rounded-lg">
  <img src="images/yuyu-chara.png" alt="悠愉樹庵 ロゴ - ページトップへ戻る" class="w-full h-auto">
</a>

<!-- Menu -->
<section id="menu" class="bg-blue-50/90 py-16 px-4 text-center">
  <div class="max-w-6xl mx-auto">
    <h2 class="text-3xl font-bold text-center mb-8">お品書き</h2>
    <div class="flex flex-wrap justify-center mb-6 gap-2">
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="all">すべて</button>
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="soba">沖縄そば</button>
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="topping">付け合せ</button>
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="chanple">チャンプルー</button>
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="set">定食</button>
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="just">単品</button>
      <button class="filter-btn bg-gray-300 px-4 py-2 rounded" data-category="sweet">デザート</button>
    </div>
    <div class="max-w-3xl mx-auto mb-6 p-4 bg-yellow-50 border border-yellow-300 rounded text-left text-sm text-gray-800">
      <p class="font-bold mb-1">【アレルゲン表示について】</p>
      <p class="mb-1">各メニューの表示は、<strong>特定原材料8品目</strong>（えび・かに・くるみ・小麦・そば・卵・乳・落花生）を対象としています。</p>
      <p class="mb-1"><strong>重篤なアレルギーをお持ちの方は、必ずご来店時にスタッフへお申し出ください。</strong>調理器具・油の共用による微量混入の可能性があります。</p>
    </div>
    <div id="menu-container" class="grid grid-cols-1 sm:grid-cols-2 gap-6 w-full md:w-[1350px] mx-auto"></div>
  </div>
</section>

<!-- Concept -->
<section id="concept" class="bg-gray-700/95 py-12 text-white">
  <div class="max-w-4xl mx-auto text-left">
    <h2 class="text-3xl font-bold mb-6">スープのこだわり</h2>
    <p class="text-lg leading-relaxed">
      豚だし骨、鶏ガラ、カツオ節をベースに化学調味料を一切使わずに丁寧に心を込めて仕上げました。
    </p>
    <h2 class="text-3xl font-bold mb-6 mt-10">お肉のこだわり</h2>
    <p class="text-lg leading-relaxed">
      三枚肉、テビチ、軟骨ソーキはいずれもスープとの相性にこだわった自家製タレでじっくり煮込んで仕上げました。
    </p>
    <h2 class="text-3xl font-bold mb-6 mt-10">お店のこだわり</h2>
    <p class="text-lg leading-relaxed">
      新鮮な県産食材を厳選し、食の安全に徹底してこだわった調理法から生まれる自然であっさりとした独特の風味をお届けします。<br>
      木々に囲まれた古民家にて心ほどける沖縄郷土料理をご用意して皆さまのお越しを心よりお待ちしております。
    </p>
  </div>
</section>

<!-- Interior -->
<section id="interior" class="bg-blue-50/90 py-16 px-4 text-center">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-2xl font-bold mb-6">店舗の内観（客席）</h2>
    <div class="relative w-full overflow-hidden rounded shadow aspect-[16/9]">
      <button onclick="prevInteriorSlide()" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 px-2" aria-label="前へ">←</button>
      <img id="interiorSlide" src="images/interior1.jpg" alt="悠愉樹庵の店内 - 落ち着いた雰囲気の客席" width="1920" height="1080"
        class="w-full h-full object-cover cursor-pointer" onclick="nextInteriorSlide()">
      <button onclick="nextInteriorSlide()" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 px-2" aria-label="次へ">→</button>
    </div>
  </div>
</section>

<!-- Exterior -->
<section id="exterior" class="bg-gray-700/95 py-12 text-white">
  <div class="max-w-4xl mx-auto text-center">
    <h2 class="text-2xl font-bold mb-6">店舗の外観</h2>
    <div class="relative w-full overflow-hidden rounded shadow">
      <button onclick="prevExteriorSlide()" class="absolute left-0 top-1/2 -translate-y-1/2 z-10 px-2" aria-label="前へ">←</button>
      <img id="exteriorSlide" src="images/exterior1.jpg" alt="悠愉樹庵の外観 - 中城村の古民家沖縄そば店"
        class="w-full h-auto object-contain bg-black" loading="lazy" onclick="nextExteriorSlide()">
      <button onclick="nextExteriorSlide()" class="absolute right-0 top-1/2 -translate-y-1/2 z-10 px-2" aria-label="次へ">→</button>
    </div>
  </div>
</section>

<!-- Info -->
<section id="info" class="bg-blue-50/90 py-16 px-4 text-left" data-collapsible>
  <div class="max-w-4xl mx-auto text-left">
    <h2 class="text-3xl font-bold mb-6">店舗案内</h2>
    <div class="collapsible-body">
    <p><strong>住所：</strong>沖縄県中城村屋宜824-1</p>
    <p><strong>営業時間：</strong>11:00〜15:00</p>
    <p><strong>電話番号：</strong><a href="tel:098-895-2280" class="underline hover:text-red-600" data-track="tel">098-895-2280</a></p>
    <p><strong>定休日：</strong>日曜日</p>
    <p><strong>座席：</strong>テーブル6卓（5席）30席、座敷20席、掘りごたつ15席、カウンター4席</p>
    <p><strong>駐車場：</strong>あり（約15台）</p>
    </div>
  </div>
</section>

<!-- Access -->
<!-- [Phase3] PERF-04: Maps iframe を data-src で遅延読み込み -->
<section id="access" class="bg-gray-700/95 py-12 text-white">
  <div class="max-w-5xl mx-auto space-y-10">
